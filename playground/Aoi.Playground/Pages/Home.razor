@page "/"
@using Aoi.Playground.Components
@using Aoi.Playground.Services
@inject NavigationManager Nav
@inject IJSRuntime Js
@inject PlaygroundState State

<PageTitle>Aoi Playground</PageTitle>

<div class="shell">
    <SiteHeader Active="play">
        <button class="btn" type="button" @onclick="ShareAsync" title="Copy share link">Share</button>
        <button class="btn" type="button" @onclick="ClearOutput">Clear</button>
        <a class="btn btn-primary btn-github"
           href="https://github.com/xiangyanhao/aoi-docs"
           target="_blank"
           rel="noopener noreferrer"
           title="Open the fork repository on GitHub">
            <svg class="github-icon" viewBox="0 0 16 16" aria-hidden="true">
                <path fill="currentColor" d="M8 0C3.58 0 0 3.58 0 8c0 3.54 2.29 6.53 5.47 7.59.4.07.55-.17.55-.38 0-.19-.01-.82-.01-1.49-2.01.37-2.53-.49-2.69-.94-.09-.23-.48-.94-.82-1.13-.28-.15-.68-.52-.01-.53.63-.01 1.08.58 1.23.82.72 1.21 1.87.87 2.33.66.07-.52.28-.87.51-1.07-1.78-.2-3.64-.89-3.64-3.95 0-.87.31-1.59.82-2.15-.08-.2-.36-1.02.08-2.12 0 0 .67-.21 2.2.82A7.7 7.7 0 0 1 8 4.77c.68 0 1.36.09 2 .27 1.53-1.04 2.2-.82 2.2-.82.44 1.1.16 1.92.08 2.12.51.56.82 1.27.82 2.15 0 3.07-1.87 3.75-3.65 3.95.29.25.54.73.54 1.48 0 1.07-.01 1.93-.01 2.2 0 .21.15.46.55.38A8.01 8.01 0 0 0 16 8c0-4.42-3.58-8-8-8z"/>
            </svg>
            <span>GitHub</span>
        </a>
    </SiteHeader>

    <div class="workspace">
        <aside class="samples">
            <h2>Samples</h2>
            <div class="sample-list">
                @foreach (var sample in SampleCatalog.All)
                {
                    <button class="sample @(sample.Id == State.ActiveSampleId ? "active" : null)"
                            type="button"
                            @onclick="() => LoadSample(sample)">
                        <span class="sample-title">@sample.Title</span>
                        <span class="sample-blurb">@sample.Blurb</span>
                    </button>
                }
            </div>
            <a class="samples-docs-link" href="@(Nav.BaseUri.TrimEnd('/') + "/docs")">Browse language docs →</a>
        </aside>

        <div class="stage" @ref="_stage">
            <section class="panel panel-source">
                <div class="panel-head">
                    <h2>Source</h2>
                    <div class="panel-head-actions">
                        <span class="meta">Ctrl/⌘ + Enter</span>
                        <button class="btn btn-primary btn-run"
                                type="button"
                                disabled="@_running"
                                title="Run (Ctrl/⌘ + Enter)"
                                @onclick="RunAsync">
                            @(_running ? "Running…" : "Run")
                        </button>
                    </div>
                </div>
                <CodeEditor Value="@State.Source"
                            ValueChanged="OnSourceChanged"
                            OnRunRequested="RunAsync"
                            AriaLabel="Aoi source editor" />
            </section>

            <div class="split-handle" @ref="_splitHandle" title="Drag to resize" role="separator" aria-orientation="horizontal"></div>

            <section class="panel panel-output" style="animation-delay: 0.08s">
                <div class="panel-head">
                    <h2>Output</h2>
                    @if (State.LastElapsedMs is long ms)
                    {
                        <span class="meta">@ms ms</span>
                    }
                </div>
                @if (!string.IsNullOrEmpty(State.Error))
                {
                    <pre class="output error">@State.Error@(!string.IsNullOrEmpty(State.Output) ? "\n\n" + State.Output : "")</pre>
                }
                else if (string.IsNullOrEmpty(State.Output) && State.LastElapsedMs is null)
                {
                    <pre class="output empty">运行结果会出现在这里。</pre>
                }
                else
                {
                    <pre class="output">@(string.IsNullOrEmpty(State.Output) ? "(no output)" : State.Output)</pre>
                }
            </section>
        </div>
    </div>
</div>

@if (!string.IsNullOrEmpty(_toast))
{
    <div class="toast" role="status">@_toast</div>
}

@code {
    private bool _running;
    private string? _toast;
    private CancellationTokenSource? _toastCts;
    private ElementReference _stage;
    private ElementReference _splitHandle;
    private bool _splitReady;

    protected override void OnInitialized()
    {
        // Load shared / Edit links. No force-reload so MusicPlayer in MainLayout keeps state.
        ApplyCodeFromUri();
    }

    private void ApplyCodeFromUri()
    {
        var uri = Nav.ToAbsoluteUri(Nav.Uri);
        if (string.IsNullOrEmpty(uri.Fragment) || !uri.Fragment.StartsWith("#code="))
            return;

        var decoded = ShareCodec.Decode(uri.Fragment["#code=".Length..]);
        if (string.IsNullOrEmpty(decoded)) return;

        State.Source = decoded;
        State.ActiveSampleId = null;
        State.Output = "";
        State.Error = null;
        State.LastElapsedMs = null;
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (_splitReady) return;
        _splitReady = true;
        try
        {
            await Js.InvokeVoidAsync("aoiPlayground.initVerticalSplit", _stage, _splitHandle, "aoi-split");
        }
        catch { /* ignore */ }
    }

    private void OnSourceChanged(string value)
    {
        State.Source = value;
        State.ActiveSampleId = null;
    }

    private void LoadSample(Sample sample)
    {
        State.Source = sample.Source;
        State.ActiveSampleId = sample.Id;
        State.Error = null;
    }

    private async Task RunAsync()
    {
        if (_running) return;
        _running = true;
        State.Error = null;
        StateHasChanged();

        await Task.Yield();
        var result = AoiRunner.Run(State.Source);
        State.Output = result.Output;
        State.Error = result.Error;
        State.LastElapsedMs = result.ElapsedMs;
        _running = false;
    }

    private void ClearOutput()
    {
        State.Output = "";
        State.Error = null;
        State.LastElapsedMs = null;
    }

    private async Task ShareAsync()
    {
        var payload = ShareCodec.Encode(State.Source);
        var url = Nav.ToAbsoluteUri(Nav.BaseUri).GetLeftPart(UriPartial.Path).TrimEnd('/') + "/#code=" + payload;
        try
        {
            await Js.InvokeVoidAsync("navigator.clipboard.writeText", url);
            await ShowToast("Share link copied.");
        }
        catch
        {
            await ShowToast(url);
        }
    }

    private async Task ShowToast(string message)
    {
        _toastCts?.Cancel();
        _toastCts = new CancellationTokenSource();
        var token = _toastCts.Token;
        _toast = message;
        try
        {
            await Task.Delay(2200, token);
            if (!token.IsCancellationRequested)
            {
                _toast = null;
                StateHasChanged();
            }
        }
        catch (TaskCanceledException) { }
    }

}
