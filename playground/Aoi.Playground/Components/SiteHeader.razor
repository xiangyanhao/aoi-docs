@inject NavigationManager Nav
@inject IJSRuntime Js

<header class="topbar">
    <div class="brand">
        <a class="brand-link" href="@BaseHref">
            <div class="brand-mark" aria-hidden="true"></div>
            <div>
                <h1>Aoi</h1>
                <p>@Subtitle</p>
            </div>
        </a>
    </div>
    <div class="top-actions">
        <nav class="nav-links" aria-label="Primary">
            <a class="nav-link @(Active == "play" ? "active" : null)" href="@BaseHref">Playground</a>
            <a class="nav-link @(Active == "docs" ? "active" : null)" href="@(BaseHref + "docs")">Docs</a>
        </nav>
        <button class="btn btn-theme" type="button" @onclick="ToggleThemeAsync"
                title="@(_isDark ? "Switch to light mode" : "Switch to dark mode")"
                aria-label="@(_isDark ? "Switch to light mode" : "Switch to dark mode")">
            @if (_isDark)
            {
                <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                    <circle cx="12" cy="12" r="4" />
                    <path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4" />
                </svg>
                <span>Light</span>
            }
            else
            {
                <svg class="theme-icon" viewBox="0 0 24 24" aria-hidden="true" fill="none" stroke="currentColor" stroke-width="1.8">
                    <path d="M21 14.5A8.5 8.5 0 1 1 9.5 3 7 7 0 0 0 21 14.5z" />
                </svg>
                <span>Dark</span>
            }
        </button>
        @ChildContent
    </div>
</header>

@code {
    [Parameter] public string Active { get; set; } = "play";
    [Parameter] public string Subtitle { get; set; } = "在浏览器里运行的轻量解释型语言 playground";
    [Parameter] public RenderFragment? ChildContent { get; set; }
    [Parameter] public EventCallback<bool> ThemeChanged { get; set; }

    private bool _isDark = true;
    private bool _ready;

    private string BaseHref => Nav.BaseUri.TrimEnd('/') + "/";

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender || _ready) return;
        _ready = true;
        try
        {
            var stored = await Js.InvokeAsync<string?>("aoiPlayground.getStoredTheme");
            if (stored is "light" or "dark")
                _isDark = stored == "dark";
            else
                _isDark = await Js.InvokeAsync<bool>("aoiPlayground.prefersDark");

            await ApplyThemeAsync();
            await ThemeChanged.InvokeAsync(_isDark);
            StateHasChanged();
        }
        catch { /* JS may not be ready */ }
    }

    private async Task ToggleThemeAsync()
    {
        _isDark = !_isDark;
        await ApplyThemeAsync();
        await ThemeChanged.InvokeAsync(_isDark);
    }

    private async Task ApplyThemeAsync()
    {
        var theme = _isDark ? "dark" : "light";
        try
        {
            await Js.InvokeVoidAsync("aoiPlayground.applyTheme", theme);
            await Js.InvokeVoidAsync("aoiPlayground.setStoredTheme", theme);
        }
        catch { /* ignore */ }
    }
}
